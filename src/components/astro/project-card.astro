---
import type { ProjectLink } from "@/data/resume";

interface Props {
  title: string;
  description: string;
  dates: string;
  tags: readonly string[];
  image?: string;
  video?: string;
  links?: readonly ProjectLink[];
}

const { title, description, dates, tags, image, video, links } = Astro.props;
---

<article class="work-plate">
  <div class="work-plate__media">
    {video && <video src={video} width="500" height="300" autoplay loop muted playsinline />}
    {image && <img src={image} alt={`${title} interface screenshot`} width="500" height="300" loading="lazy" />}
  </div>

  <div class="work-plate__body">
    <time class="work-plate__dates">{dates}</time>
    <h3 class="work-plate__title">{title}</h3>
    <p class="work-plate__desc">{description}</p>

    {
      tags && tags.length > 0 && (
        <p class="work-plate__stack">{tags.join(" · ")}</p>
      )
    }

    {
      links && links.length > 0 && (
        <div class="hero-actions">
          {links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="ascii-btn-secondary">
              [{link.type}]
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
