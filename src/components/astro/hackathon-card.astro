---
interface Props {
  title: string;
  description: string;
  dates: string;
  location: string;
  image: string;
  active?: boolean;
}

const { title, description, dates, location, image, active = false } = Astro.props;
---

<li class="guild-row">
  <div class="guild-row__meta">
    {image && <img src={image} alt={location} class="crest-img" width="40" height="40" loading="lazy" />}
    <div>
      <span class:list={["guild-row__status", active && "guild-row__status--active"]}>
        [{active ? "active" : "past"}]
      </span>
      {dates && <time class="guild-row__dates">{dates}</time>}
      {location && <p class="guild-row__org">{location}</p>}
    </div>
  </div>

  <div>
    <h3 class="guild-row__title">{title}</h3>
    {description && <p class="guild-row__desc">{description}</p>}
  </div>
</li>
