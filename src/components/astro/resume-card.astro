---
interface Props {
  logoUrl: string;
  altText: string;
  title: string;
  subtitle?: string;
  href?: string;
  period: string;
}

const { logoUrl, altText, title, subtitle, href, period } = Astro.props;
---

<article class="academy-row">
  <div class="academy-row__left">
    {logoUrl && <img src={logoUrl} alt={altText} class="crest-img" width="40" height="40" loading="lazy" />}
    <div>
      <h3 class="academy-row__school">
        {
          href ? (
            <a href={href} target="_blank" rel="noopener noreferrer">
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      {subtitle && <p class="academy-row__degree">{subtitle}</p>}
    </div>
  </div>
  <time class="academy-row__period">{period}</time>
</article>
