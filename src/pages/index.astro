---
import CampfireHero from "@/components/astro/campfire-hero.astro";
import HackathonCard from "@/components/astro/hackathon-card.astro";
import ProjectCard from "@/components/astro/project-card.astro";
import ResumeCard from "@/components/astro/resume-card.astro";
import { DATA } from "@/data/resume";
import Layout from "@/layouts/layout.astro";
---

<Layout title={DATA.name} description={`${DATA.name}, ${DATA.description}.`}>
  <main class="ascii-main">
    <!-- Hero -->
    <section id="hero" class="hero">
      <CampfireHero />

      <div class="hero-intro">
        <div>
          <h1 class="hero-title">
            <span class="hero-prefix">&gt;</span> {DATA.name}
          </h1>
          <p class="hero-subtitle">
            {DATA.description}
          </p>
        </div>
        <div class="hero-actions">
          {/* <a href="#projects" class="ascii-btn-primary">[ view works ]</a> */}
          <a href="#contact" class="ascii-btn-primary">[ send a raven ]</a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">01 /</span> chronicle
      </h2>
      <blockquote class="chronicle-quote">
        {DATA.summary}
      </blockquote>
    </section>

    <!-- Experience -->
    <section id="work" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">02 /</span> guilds
      </h2>
      <ul class="guild-list">
        {
          DATA.work.map((work) => (
            <HackathonCard
              title={work.title}
              description={work.description}
              location={`${work.company} · ${work.location}`}
              dates={`${work.start} - ${work.end}`}
              image={work.logoUrl}
              active={work.end === "Present"}
            />
          ))
        }
      </ul>
    </section>

    <!-- Education -->
    <section id="education" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">03 /</span> academy
      </h2>
      {
        DATA.education.map((edu) => (
          <ResumeCard
            href={edu.href}
            logoUrl={edu.logoUrl}
            altText={edu.school}
            title={edu.school}
            subtitle={edu.degree}
            period={`${edu.start} - ${edu.end}`}
          />
        ))
      }
    </section>

    <!-- Skills -->
    <section id="skills" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">04 /</span> arsenal
      </h2>
      <ul class="arsenal-grid" aria-label="Technical skills">
        {
          DATA.skills.map((skill, idx) => (
            <li class="arsenal-cell">
              <span class="arsenal-cell__idx">{String(idx + 1).padStart(2, "0")}</span>
              <span class="arsenal-cell__name">{skill}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Projects
    <section id="projects" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">05 /</span> works
      </h2>
      <div class="works-stack">
        {
          DATA.projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              dates={project.dates}
              tags={project.technologies}
              image={project.image}
              video={project.video}
              links={project.links}
            />
          ))
        }
      </div>
    </section>
    */}

    <!-- Contact -->
    <section id="contact" class="section-block">
      <h2 class="section-heading">
        <span class="section-num">05 /</span> raven
      </h2>
      <div class="raven-band">
        <p>
          Want to chat? Reach out directly on LinkedIn, inspect my code on GitHub,
          or write to me by email.
        </p>
        <div class="raven-actions">
          <a
            href={DATA.contact.social.LinkedIn.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ascii-btn-primary"
          >
            [ linkedin ]
          </a>
          <a
            href={DATA.contact.social.GitHub.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ascii-btn-secondary"
          >
            [ github ]
          </a>
          <a
            href={DATA.contact.social.Email.url}
            class="ascii-btn-secondary"
          >
            [ {DATA.contact.email} ]
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
